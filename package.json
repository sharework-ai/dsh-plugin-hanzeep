{
  "name": "dsh-plugin-hanzeep",
  "description": "Closed-loop AI document generation for deepseek-harness: domain rule packs + replayable validation receipts",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./pack": {
      "types": "./lib/types/pack.d.ts",
      "default": "./lib/pack.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "packs",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "document-generation",
    "validation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.0.0",
    "@deepseek-ai/dsh-llm": ">=0.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.0",
    "@deepseek-ai/schemastery": ">=0.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "file:../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-scope": "file:../deepseek-harness/packages/core/scope",
    "@deepseek-ai/dsh-session": "file:../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-timeout": "file:../deepseek-harness/packages/util/timeout",
    "@deepseek-ai/dsh-tools": "file:../deepseek-harness/packages/core/tools",
    "@deepseek-ai/schemastery": "file:../deepseek-harness/vendor/schemastery",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsdown": "^0.12.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/schemastery": "file:../deepseek-harness/vendor/schemastery",
      "@deepseek-ai/cordis": "^4.0.1",
      "@deepseek-ai/cosmokit": "^1.8.2"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@deepseek-ai/*"
      ]
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "typecheck": "tsc -b tsconfig.json --emitDeclarationOnly false --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "spike:convergence": "node --import tsx/esm spike/convergence.ts"
  }
}
